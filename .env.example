# Optional production server configuration. No credentials belong in this file.
HOST=127.0.0.1
PORT=4173

# Required on Vercel; optional for persistent sessions during local development.
# Copy the REST URL and REST token from your Upstash Redis database.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Generate a 64-character hex secret:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# GCC_SESSION_SECRET=
