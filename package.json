{
  "name": "gcc-compass-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "check": "npm test && node scripts/verify_opportunity_data.mjs && npm run build",
    "check:redis": "node --env-file-if-exists=.env scripts/verify_redis_connection.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.3",
    "jsdom": "^26.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": "22.x"
  }
}
